#: crates/app/src/app.rs:55
msgid "System check"
msgstr "Verificação do sistema"

#: crates/app/src/app.rs:59
msgid "Check again"
msgstr "Verificar novamente"

#: crates/app/src/app.rs:65
msgid "Continue"
msgstr "Continuar"

#: crates/app/src/app.rs:118
msgid "Unknown distribution"
msgstr "Distribuição desconhecida"

#: crates/app/src/app.rs:123
msgid "no compatible GPU"
msgstr "nenhuma GPU compatível"

#: crates/app/src/app.rs:133
msgid "Everything looks good"
msgstr "Tudo certo"

#: crates/app/src/app.rs:135
msgid "This computer meets the requirements for DaVinci Resolve."
msgstr "Este computador atende aos requisitos do DaVinci Resolve."

#: crates/app/src/messages.rs:19
msgid "No compatible GPU found"
msgstr "Nenhuma GPU compatível encontrada"

#: crates/app/src/messages.rs:20
msgid "DaVinci Resolve needs a GPU with CUDA, ROCm or OpenCL support."
msgstr ""
"O DaVinci Resolve precisa de uma GPU com suporte a CUDA, ROCm ou OpenCL."

#: crates/app/src/messages.rs:23
msgid "proprietary driver required"
msgstr "driver proprietário necessário"

#: crates/app/src/messages.rs:24
msgid ""
"Install the NVIDIA driver from your distribution, restart, then open Vinci "
"again."
msgstr ""
"Instale o driver da NVIDIA pela sua distribuição, reinicie e abra o Vinci "
"novamente."

#: crates/app/src/messages.rs:27
msgid "experimental support"
msgstr "suporte experimental"

#: crates/app/src/messages.rs:28
msgid ""
"This GPU is not officially supported by ROCm. Vinci applies a known "
"workaround, but Resolve may be unstable."
msgstr ""
"Esta GPU não é suportada oficialmente pelo ROCm. O Vinci aplica uma solução "
"conhecida, mas o Resolve pode ficar instável."

#: crates/app/src/messages.rs:31
msgid "unknown compatibility"
msgstr "compatibilidade desconhecida"

#: crates/app/src/messages.rs:32
msgid ""
"Vinci could not tell whether this GPU works with Resolve. You can try anyway."
msgstr ""
"O Vinci não conseguiu determinar se esta GPU funciona com o Resolve. Você "
"pode tentar mesmo assim."

#: crates/app/src/messages.rs:35
msgid "not supported"
msgstr "não suportada"

#: crates/app/src/messages.rs:38
msgid "AMD GPUs older than Vega are not supported by current ROCm."
msgstr "GPUs AMD anteriores à Vega não são suportadas pelo ROCm atual."

#: crates/app/src/messages.rs:41
msgid "Intel GPUs older than 12th generation (Tiger Lake) are not supported."
msgstr "GPUs Intel anteriores à 12ª geração (Tiger Lake) não são suportadas."

#: crates/app/src/messages.rs:43
msgid "This display adapter has no compute support."
msgstr "Este adaptador de vídeo não tem suporte a processamento."

#: crates/app/src/messages.rs:47
msgid "Multiple GPUs detected"
msgstr "Várias GPUs detectadas"

#: crates/app/src/messages.rs:48
msgid "Resolve will run on"
msgstr "O Resolve vai usar a"

#: crates/app/src/messages.rs:51
msgid "Low memory"
msgstr "Pouca memória"

#: crates/app/src/messages.rs:52
msgid "Blackmagic recommends 16 GiB or more. Large projects may be slow."
msgstr ""
"A Blackmagic recomenda 16 GiB ou mais. Projetos grandes podem ficar lentos."

#: crates/app/src/messages.rs:55
msgid "Very low memory"
msgstr "Memória muito baixa"

#: crates/app/src/messages.rs:56
msgid "Resolve may close unexpectedly with less than 8 GiB."
msgstr "O Resolve pode fechar inesperadamente com menos de 8 GiB."

#: crates/app/src/messages.rs:59
msgid "Little free space"
msgstr "Pouco espaço livre"

#: crates/app/src/messages.rs:60
msgid ""
"Installing works, but caches and renders need room. 40 GiB or more is "
"recommended."
msgstr ""
"A instalação funciona, mas cache e renderizações precisam de espaço. "
"Recomenda-se 40 GiB ou mais."

#: crates/app/src/messages.rs:63
msgid "Not enough free space"
msgstr "Espaço livre insuficiente"

#: crates/app/src/messages.rs:64
msgid "At least 12 GiB of free space is required."
msgstr "São necessários pelo menos 12 GiB de espaço livre."

msgid "A required program could not be started."
msgstr "Um programa necessário não pôde ser iniciado."

msgid "Adding the GPU driver repository"
msgstr "Adicionando o repositório do driver da GPU"

msgid "Applying compatibility fixes"
msgstr "Aplicando correções de compatibilidade"

msgid "Back"
msgstr "Voltar"

msgid "Cancel"
msgstr "Cancelar"

msgid "Checking the installation"
msgstr "Conferindo a instalação"

msgid "Choose file…"
msgstr "Escolher arquivo…"

msgid "Choose the installer"
msgstr "Escolha o instalador"

msgid "Could not install"
msgstr "Não foi possível instalar o"

msgid "Creating the container"
msgstr "Criando o container"

msgid "DaVinci Resolve installer"
msgstr "Instalador do DaVinci Resolve"

msgid "DaVinci Resolve is installed"
msgstr "O DaVinci Resolve está instalado"

msgid "Distrobox (installed in your user folder, no password)"
msgstr "Distrobox (instalado na sua pasta de usuário, sem senha)"

msgid "Download DaVinci Resolve for Linux from Blackmagic Design's website. Vinci finds the file in your Downloads folder automatically."
msgstr "Baixe o DaVinci Resolve para Linux no site da Blackmagic Design. O Vinci encontra o arquivo na sua pasta Downloads automaticamente."

msgid "Downloading the base system"
msgstr "Baixando o sistema base"

msgid "Extracting the installer"
msgstr "Extraindo o instalador"

msgid "Install"
msgstr "Instalar"

msgid "Install podman with your distribution's package manager, then open Vinci again."
msgstr "Instale o podman pelo gerenciador de pacotes da sua distribuição e abra o Vinci novamente."

msgid "Installation failed"
msgstr "A instalação falhou"

msgid "Installing DaVinci Resolve"
msgstr "Instalando o DaVinci Resolve"

msgid "Installing libraries and GPU support"
msgstr "Instalando bibliotecas e suporte à GPU"

msgid "It is in your applications menu. Your projects stay in your home folder."
msgstr "Ele está no menu de aplicativos. Seus projetos ficam na sua pasta pessoal."

msgid "No installer found in your Downloads folder yet."
msgstr "Nenhum instalador encontrado na pasta Downloads ainda."

msgid "Open DaVinci Resolve"
msgstr "Abrir o DaVinci Resolve"

msgid "Open download page"
msgstr "Abrir página de download"

msgid "Podman (container engine, asks for your password)"
msgstr "Podman (motor de containers, pede sua senha)"

msgid "Podman is required"
msgstr "O Podman é necessário"

msgid "Preparing"
msgstr "Preparando"

msgid "Recreating the container and trying again"
msgstr "Recriando o container e tentando de novo"

msgid "Removing the previous installation"
msgstr "Removendo a instalação anterior"

msgid "Resolve was installed, but Vinci could not save its settings."
msgstr "O Resolve foi instalado, mas o Vinci não conseguiu salvar as configurações."

msgid "Resolve was installed, but the menu entry could not be created."
msgstr "O Resolve foi instalado, mas o atalho no menu não pôde ser criado."

msgid "Setting up the container"
msgstr "Configurando o container"

msgid "These tools run DaVinci Resolve in an isolated container:"
msgstr "Estas ferramentas rodam o DaVinci Resolve em um container isolado:"

msgid "This step failed:"
msgstr "Este passo falhou:"

msgid "This takes a few minutes. You can keep using your computer."
msgstr "Isso leva alguns minutos. Você pode continuar usando o computador."

msgid "Try again"
msgstr "Tentar novamente"

msgid "Trying mirror"
msgstr "Tentando o espelho"

msgid "Vinci needs to install some tools"
msgstr "O Vinci precisa instalar algumas ferramentas"

msgid "Waiting for the download to finish in your Downloads folder…"
msgstr "Aguardando o download terminar na pasta Downloads…"

msgid "distrobox is missing"
msgstr "o distrobox não foi encontrado"

msgid "Copy diagnostic report"
msgstr "Copiar relatório de diagnóstico"

msgid "Diagnostic report copied. Paste it in your issue or message."
msgstr "Relatório de diagnóstico copiado. Cole na sua issue ou mensagem."
