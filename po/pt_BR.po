msgstr "Para editar: DNxHR HQ (qualquer edição, arquivos grandes)"

#: crates/app/src/media.rs:45
msgid "For editing: ProRes 422 (large files)"
msgstr "Para editar: ProRes 422 (arquivos grandes)"

#: crates/app/src/media.rs:47
msgid "For editing: fix audio only (Studio with NVIDIA)"
msgstr "Para editar: corrigir só o áudio (Studio com NVIDIA)"

#: crates/app/src/media.rs:50
msgid "For editing: MPEG-4 (Diolinux preset)"
msgstr "Para editar: MPEG-4 (preset do Diolinux)"

