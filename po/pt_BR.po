#: crates/app/src/messages.rs:91
msgid "Setting up the container"
msgstr "Configurando o container"

#: crates/app/src/messages.rs:92
msgid "Adding the GPU driver repository"
msgstr "Adicionando o repositório do driver da GPU"

#: crates/app/src/messages.rs:93
msgid "Installing libraries and GPU support"
msgstr "Instalando bibliotecas e suporte à GPU"

#: crates/app/src/messages.rs:94
msgid "Extracting the installer"
msgstr "Extraindo o instalador"

#: crates/app/src/messages.rs:96
msgid "Checking the installation"
msgstr "Conferindo a instalação"

#: crates/app/src/messages.rs:97
msgid "Applying compatibility fixes"
msgstr "Aplicando correções de compatibilidade"

#: crates/app/src/messages.rs:98
msgid "Installing podman"
msgstr "Instalando o podman"

#: crates/app/src/messages.rs:99
msgid "Installing distrobox"
msgstr "Instalando o distrobox"

#: crates/app/src/messages.rs:105
msgid "Podman (container engine, asks for your password)"
msgstr "Podman (motor de containers, pede sua senha)"

#: crates/app/src/messages.rs:107
msgid "Distrobox (installed in your user folder, no password)"
msgstr "Distrobox (instalado na sua pasta de usuário, sem senha)"

#: crates/app/src/messages.rs:117
msgid "This step failed:"
msgstr "Este passo falhou:"

#: crates/app/src/messages.rs:120
msgid "A required program could not be started."
msgstr "Um programa necessário não pôde ser iniciado."

#: crates/app/src/messages.rs:123
msgid "The installation was cancelled."
msgstr "A instalação foi cancelada."

#: crates/app/src/messages.rs:126
msgid "Resolve was installed, but the menu entry could not be created."
msgstr "O Resolve foi instalado, mas o atalho no menu não pôde ser criado."

#: crates/app/src/messages.rs:129
msgid "Resolve was installed, but Vinci could not save its settings."
msgstr ""
"O Resolve foi instalado, mas o Vinci não conseguiu salvar as configurações."

#: crates/app/src/messages.rs:139
msgid "The Resolve container is missing"
msgstr "O container do Resolve não foi encontrado"

#: crates/app/src/messages.rs:140
msgid ""
"It may have been removed by a system cleanup. Reinstall to get it back; your "
"projects are safe."
msgstr ""
"Ele pode ter sido removido por uma limpeza do sistema. Reinstale para "
"recuperá-lo; seus projetos estão seguros."

#: crates/app/src/messages.rs:143
msgid "DaVinci Resolve is missing from its container"
msgstr "O DaVinci Resolve sumiu do container"

#: crates/app/src/messages.rs:144
msgid "Reinstall to fix it; your projects are safe."
msgstr "Reinstale para corrigir; seus projetos estão seguros."

#: crates/app/src/messages.rs:147
msgid "The menu entry is missing"
msgstr "O atalho no menu sumiu"

#: crates/app/src/messages.rs:148
msgid "Vinci can create it again."
msgstr "O Vinci pode criá-lo de novo."

#: crates/app/src/messages.rs:151
msgid "The GPU is not visible to Resolve"
msgstr "O Resolve não está enxergando a GPU"

#: crates/app/src/messages.rs:152
msgid ""
"This usually happens after a driver update. Restart the computer; if it "
"persists, copy the diagnostic report and ask for help."
msgstr ""
"Isso costuma acontecer depois de atualizar o driver. Reinicie o computador; "
"se continuar, copie o relatório de diagnóstico e peça ajuda."

#: crates/app/src/messages.rs:155
msgid "The Resolve container needs an update"
msgstr "O container do Resolve precisa de uma atualização"

#: crates/app/src/messages.rs:156
msgid ""
"This version of Vinci installs newer GPU and video drivers in it. Your "
"projects and Resolve's settings are kept."
